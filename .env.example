# Modèle de configuration — AUCUNE VALEUR RÉELLE ICI (fichier versionné).
# Copier en .env.local et remplir. Voir AD-9 du squelette d'architecture.

# Clé API Anthropic (console.anthropic.com). JAMAIS dans le dépôt ni dans un prompt.
ANTHROPIC_API_KEY=

# Répertoire du contenu privé : cv.yaml, qa.fr.md, qa.en.md, assets/, tests/
# Dév : chemin vers le dossier content/ du dépôt privé CV.
# Chemin **absolu** : le build autonome se place dans .next/standalone avant de
# démarrer, un chemin relatif y désignerait un répertoire inexistant.
CONTENT_DIR=

# Répertoire des données : usage.db (journal des visites). Hors dépôt.
# Chemin **absolu**, pour la même raison que CONTENT_DIR. Il doit exister et
# être inscriptible : le démarrage échoue sinon, le site ne le crée pas.
DATA_DIR=

# URL publique du site
NEXT_PUBLIC_SITE_URL=https://cv.jnouvelle.com

# Écoute locale — Caddy est la seule porte publique (AD-10)
HOSTNAME=127.0.0.1
PORT=3000

# Dév uniquement : 1 pour servir /admin en local (jamais en production)
ADMIN_DEV=0
