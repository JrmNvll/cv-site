# Secrets — jamais versionnés (AD-9)
.env
.env.local
.env.*.local

# Contenu privé — jamais dans ce dépôt (AD-2).
# « Je copie content/ à la racine, juste pour essayer » est le chemin le plus
# court vers une fuite de données personnelles dans un dépôt public. Ce filet
# rattrape le geste ; le contrôle qui refuse tout cv.yaml ou qa.*.md hors des
# fixtures vit dans tests/unit/content-repo-guard.test.ts.
/content/

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Données locales (AD-7 : usage.db vit dans DATA_DIR, hors dépôt)
data/
*.db
*.db-journal

# Système / éditeur
Thumbs.db
desktop.ini
.DS_Store
*.tmp

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
